    "ImageDescription": {
      "value": "<div class=\"description\">\nFull disk view of the Earth taken on December 7, 1972, by the crew of the <a href=\"https://en.wikipedia.org/wiki/Apollo_17\" class=\"extiw\" title=\"en:Apollo 17\">Apollo 17</a> spacecraft en route to the Moon at a distance of about 29,400 kilometres (18,300 mi). It shows <a href=\"https://en.wikipedia.org/wiki/Africa\" class=\"extiw\" title=\"en:Africa\">Africa</a>, <a href=\"https://en.wikipedia.org/wiki/Antarctica\" class=\"extiw\" title=\"en:Antarctica\">Antarctica</a>, and the <a href=\"https://en.wikipedia.org/wiki/Arabian_Peninsula\" class=\"extiw\" title=\"en:Arabian Peninsula\">Arabian Peninsula</a>.</div>",
      "source": "commons-desc-page"
    },
